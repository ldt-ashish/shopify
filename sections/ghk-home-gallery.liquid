<section class="ghk-homepage ghk-section ghk-gallery">
  <div class="ghk-wrap">
    <header class="ghk-section__head">
      <p class="ghk-kicker ghk-section__kicker">{{ section.settings.kicker }}</p>
      <h2 class="ghk-title ghk-section__title">{{ section.settings.heading }}</h2>
      {% if section.settings.copy != blank %}
        <p class="ghk-copy">{{ section.settings.copy }}</p>
      {% endif %}
    </header>

    <div class="ghk-gallery__grid">
      {% for block in section.blocks %}
        <article class="ghk-gallery-card" {{ block.shopify_attributes }}>
          <div class="ghk-gallery-card__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag: widths: '450,700,900,1200', sizes: '(min-width: 750px) 33vw, 72vw', loading: 'lazy', alt: block.settings.name
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <p class="ghk-gallery-card__stars">?????</p>
          <blockquote class="ghk-gallery-card__quote">{{ block.settings.quote }}</blockquote>
          <p class="ghk-gallery-card__meta">{{ block.settings.name }}{% if block.settings.location != blank %}, {{ block.settings.location }}{% endif %}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GHK Gallery & Reviews",
  "tag": "section",
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The finish is exceptional and the piece settled beautifully into our garden design."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Mrs. Thorne"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Cotswolds"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The Garden Gallery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved in Gardens Across Britain"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "A glimpse into real homes where Garden Heritage pieces have become part of everyday outdoor life."
    }
  ],
  "presets": [
    {
      "name": "GHK Gallery & Reviews",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}
