<section class="ghk-homepage ghk-urgency">
  <div class="ghk-wrap">
    <div class="ghk-urgency__inner">
      <p class="ghk-kicker ghk-urgency__kicker">{{ section.settings.kicker }}</p>
      <h2 class="ghk-title ghk-urgency__title">{{ section.settings.heading }}</h2>
      <p class="ghk-copy ghk-urgency__copy">{{ section.settings.copy }}</p>
      {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
        <div>
          <a class="ghk-button" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GHK Limited Batch",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Limited Seasonal Availability"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Produced in Small, Meticulous Batches"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "To preserve quality and finish standards, each release is workshop-limited. Explore current allocation before this season closes."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "View Current Availability"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ],
  "presets": [
    {
      "name": "GHK Limited Batch"
    }
  ]
}
{% endschema %}
