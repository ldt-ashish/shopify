<section class="ghk-homepage ghk-section ghk-products">
  <div class="ghk-wrap">
    <header class="ghk-section__head">
      <p class="ghk-kicker ghk-section__kicker">{{ section.settings.kicker }}</p>
      <h2 class="ghk-title ghk-section__title">{{ section.settings.heading }}</h2>
      {% if section.settings.copy != blank %}
        <p class="ghk-copy">{{ section.settings.copy }}</p>
      {% endif %}
    </header>

    {% assign featured_collection = section.settings.collection %}
    {% if featured_collection != blank and featured_collection.products_count > 0 %}
      <div class="ghk-products__grid">
        {% for product in featured_collection.products limit: section.settings.limit %}
          <a class="ghk-product-card" href="{{ product.url }}">
            <div class="ghk-product-card__media">
              {% if product.featured_image != blank %}
                {{
                  product.featured_image
                  | image_url: width: 1200
                  | image_tag: widths: '500,700,900,1100', sizes: '(min-width: 750px) 25vw, 72vw', loading: 'lazy', alt: product.title
                }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <p class="ghk-product-card__meta">Small-batch piece</p>
            <h3 class="ghk-product-card__title">{{ product.title }}</h3>
            <p class="ghk-product-card__price">{{ product.price | money }}</p>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <p class="ghk-copy">Select a collection in this section to show featured products.</p>
    {% endif %}

    {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
      <div style="margin-top: 2rem;">
        <a class="ghk-button" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "GHK Featured Products",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Signature Pieces"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Chosen for Lasting Beauty"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "Our most-loved designs, selected for craftsmanship, durability, and presence in the garden."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Shop Bestsellers"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ],
  "presets": [
    {
      "name": "GHK Featured Products"
    }
  ]
}
{% endschema %}
