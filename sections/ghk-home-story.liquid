<section class="ghk-homepage ghk-section ghk-story">
  <div class="ghk-wrap">
    <div class="ghk-story__panel">
      <div class="ghk-story__media">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1800
            | image_tag: widths: '700,900,1200,1600,1800', sizes: '(min-width: 750px) 52vw, 100vw', loading: 'lazy', alt: section.settings.image.alt
          }}
        {% else %}
          <img
            src="{{ 'ghk-hero.png' | asset_url }}"
            alt="Our Heritage"
            loading="lazy"
          >
        {% endif %}
      </div>

      <div class="ghk-story__content">
        <p class="ghk-kicker ghk-section__kicker">{{ section.settings.kicker }}</p>
        <h2 class="ghk-title ghk-section__title">{{ section.settings.heading }}</h2>
        <p class="ghk-copy">{{ section.settings.copy }}</p>
        <p class="ghk-copy">{{ section.settings.copy_secondary }}</p>

        {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
          <div>
            <a class="ghk-button" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
          </div>
        {% endif %}

        <p class="ghk-story__signature">{{ section.settings.signature }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GHK Story",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Our Heritage"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the Highlands to Your Home"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Paragraph 1",
      "default": "Founded on the rugged beauty of the British Isles, Garden Heritage UK preserves traditional craftsmanship in every form and finish."
    },
    {
      "type": "textarea",
      "id": "copy_secondary",
      "label": "Paragraph 2",
      "default": "Each piece is created in close collaboration with specialist makers, resulting in objects that feel rooted, substantial, and quietly refined."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Discover Craftsmanship"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature line",
      "default": "Garden Heritage Workshop, Somerset"
    }
  ],
  "presets": [
    {
      "name": "GHK Story"
    }
  ]
}
{% endschema %}
